# Enter these values in the hosting environment manager, or copy this to .env.
# Priority: host environment > .env > config.json. Restart after changes.

# Secret from Discord Developer Portal > your application > Bot.
# Keep the real value out of chat, screenshots, and source control.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Discord server ID, copied with Developer Mode enabled; not application ID.
DISCORD_SERVER_ID=0

# Full in-game guild name. Members are discovered automatically.
WYNN_GUILD_NAME="PUT_YOUR_FULL_GUILD_NAME_HERE"

# 0 disables the automatic board. Later, enter a regular text channel's ID.
LEADERBOARD_CHANNEL_ID=0

# 300 means five minutes. Minimum 120; maximum 86400 (one day).
REFRESH_SECONDS=300

# Writable folder relative to index.js, or an absolute persistent path.
# Preserve its leaderboard.json file across restarts and code updates.
DATA_DIR=data

# bot: connect to Discord; check-api: check Wynncraft and exit;
# check-config: validate settings without connecting to either service.
# Use this setting for diagnostics on a host without shell access.
RUN_MODE=bot
